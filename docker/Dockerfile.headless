FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl git jq nodejs npm tar gzip && rm -rf /var/lib/apt/lists/*
RUN npm install --global tree-sitter-cli

ARG NVIM_RELEASE_API_URL=https://api.github.com/repos/neovim/neovim/releases/latest
RUN release="$(curl -fsSL "$NVIM_RELEASE_API_URL")" && \
    url="$(printf '%s' "$release" | jq -er '.assets[] | select(.name == "nvim-linux-x86_64.tar.gz") | .browser_download_url')" && \
    digest="$(printf '%s' "$release" | jq -er '.assets[] | select(.name == "nvim-linux-x86_64.tar.gz") | .digest | select(startswith("sha256:")) | ltrimstr("sha256:")')" && \
    curl -fsSL "$url" -o /tmp/nvim.tar.gz && \
    echo "$digest  /tmp/nvim.tar.gz" | sha256sum -c - && \
    tar -C /opt -xzf /tmp/nvim.tar.gz && rm /tmp/nvim.tar.gz && \
    ln -s /opt/nvim-linux-x86_64/bin/nvim /usr/local/bin/nvim

RUN useradd --create-home --shell /bin/bash dotfiles
ENV HOME=/home/dotfiles
USER dotfiles
WORKDIR /home/dotfiles
COPY --chown=dotfiles:dotfiles config/nvim /home/dotfiles/.config/nvim
RUN nvim --headless '+Lazy! sync' \
    '+lua if not vim.wait(120000, function() return vim.uv.fs_stat(vim.fn.stdpath("data") .. "/site/parser/c_sharp.so") ~= nil end, 100) then print("C# parser installation timed out"); vim.cmd.cquit(1) end' \
    '+qa!'
CMD ["nvim", "--headless", "+qa!"]
